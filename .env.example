# Copy to .env.local for your computer, or add these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# The live address, once the domain is bought (used in WhatsApp links and sharing previews).
NEXT_PUBLIC_SITE_URL=

# Order emails (https://resend.com). Without a key, emails are saved to .data/emails/ on your computer,
# and the live site only accepts "Order on WhatsApp" orders.
RESEND_API_KEY=
# Sender, once your domain is verified in Resend, e.g. "Art Studio <orders@artstudio.in>".
ORDER_EMAIL_FROM=

# Razorpay (also set payments.razorpayEnabled = true in src/config/site.ts, after Phase 4).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
